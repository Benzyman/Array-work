---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, offices, telHref } from '../data/site';
import { services } from '../data/services';

const year = new Date().getFullYear();
const head = offices.find((o) => 'primary' in o && o.primary);
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo tone="dark" />
        <p class="footer__blurb">
          Geotechnical, mining and energy engineering consultancy. Registered in Nigeria, working across Africa and beyond since {site.founded}.
        </p>
        <ul role="list" class="footer__social">
          {
            site.social.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (opens in a new tab)`}>
                  <Icon name={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        <div>
          <p class="footer__heading">Services</p>
          <ul role="list">
            {services.slice(0, 6).map((s) => <li><a href={`/services/${s.slug}`}>{s.title.replace(', Planning & Engineering', '')}</a></li>)}
            <li><a href="/services" class="footer__more">All services →</a></li>
          </ul>
        </div>
        <div>
          <p class="footer__heading">Company</p>
          <ul role="list">
            <li><a href="/about">About</a></li>
            <li><a href="/team">Leadership & team</a></li>
            <li><a href="/insights">Insights</a></li>
            <li><a href="/careers">Careers</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="footer__heading">Head office</p>
          <address>
            {head && 'address' in head && head.address.map((l) => <span>{l}</span>)}
          </address>
          <ul role="list" class="footer__contact">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {site.phones.slice(0, 2).map((p) => <li><a href={telHref(p)}>{p}</a></li>)}
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name}. All rights reserved. · RC {site.rcNumber}</p>
      <p class="mono footer__coords">9.0579° N · 7.4951° E — Abuja</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-950);
    color: var(--text-on-dark-muted);
    font-size: var(--fs-sm);
    padding-top: var(--space-20);
  }

  .footer__top {
    display: grid;
    gap: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .footer__brand {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    justify-items: start;
    max-width: 22rem;
  }

  .footer__blurb {
    line-height: var(--lh-relaxed);
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    color: var(--text-on-dark);
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .footer__social a:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .footer__social .icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .footer__cols {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .footer__heading {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--stone-400);
  }

  .footer ul {
    display: grid;
    gap: 0.65rem;
  }

  .footer a {
    color: var(--text-on-dark);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer nav a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--cardinal-400);
  }

  .footer__more {
    color: var(--cardinal-200) !important;
  }

  address {
    display: grid;
    gap: 0.2rem;
    margin-bottom: var(--space-4);
    font-style: normal;
    line-height: var(--lh-normal);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border-dark);
    font-size: var(--fs-xs);
  }

  .footer__coords {
    color: var(--ink-500);
  }

  @media (min-width: 64rem) {
    .footer__top {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-16);
    }
  }
</style>
