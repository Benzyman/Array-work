---
/**
 * Official Geocardinal logo. The artwork has black elements, so on dark
 * surfaces it sits on a light plate (`tone="dark"`).
 */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
  height?: number;
}
const { tone = 'light', class: className, height = 46 } = Astro.props;
const width = Math.round((378 / 102) * height);
---

<a href="/" class:list={['logo', `logo--${tone}`, className]} aria-label="Geocardinal Engineering Services Limited — home">
  <img src="/brand/geocardinal-logo.png" alt="" width={width} height={height} decoding="async" />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    border-radius: var(--radius-sm);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .logo:hover {
    opacity: 0.85;
  }
  .logo img {
    height: auto;
    max-width: 100%;
  }
  .logo--dark {
    padding: 0.6rem 0.85rem;
    background: #fff;
    border-radius: var(--radius-md);
  }
</style>
