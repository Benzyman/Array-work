---
import Icon from './Icon.astro';
import Topo from './Topo.astro';
import { site, telHref } from '../data/site';

interface Props {
  title?: string;
  body?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Have ground that needs answers?',
  body = 'Tell us about your site, your stage and your deadline. We’ll connect you with the right engineer to scope it properly.',
  href = '/contact',
  label = 'Start a project',
} = Astro.props;
---

<section class="section cta-wrap" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta on-dark" data-reveal>
      <div class="cta__topo">
        <Topo seed={29} animate={false} summits={[{ x: 1250, y: 420, rings: 20, spacing: 22, start: 10 }]} />
      </div>
      <div class="cta__body">
        <h2 id="cta-title" class="cta__title">{title}</h2>
        <p class="cta__text">{body}</p>
      </div>
      <div class="cta__actions">
        <a href={href} class="btn btn--primary btn--lg">
          {label} <Icon name="arrow-right" class="icon--arrow" />
        </a>
        <a href={telHref(site.phones[0])} class="btn btn--ghost-dark btn--lg">
          <Icon name="phone" /> {site.phones[0]}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    padding-top: 0;
  }
  .cta {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--space-8);
    padding: clamp(2rem, 1rem + 4vw, 4.5rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 140% at 100% 100%, rgba(199, 54, 43, 0.22), transparent 55%),
      var(--ink-900);
    color: var(--text-on-dark);
    box-shadow: var(--shadow-lg);
  }
  .cta__topo {
    position: absolute;
    inset: 0;
    color: rgba(255, 255, 255, 0.11);
  }
  .cta__body,
  .cta__actions {
    position: relative;
  }
  .cta__title {
    font-size: var(--fs-3xl);
    letter-spacing: var(--tracking-tighter);
    max-width: 18ch;
  }
  .cta__text {
    margin-top: var(--space-4);
    max-width: 34rem;
    color: var(--text-on-dark-muted);
    font-size: var(--fs-lg);
    line-height: var(--lh-relaxed);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-self: end;
  }
  @media (min-width: 60rem) {
    .cta {
      grid-template-columns: 1.4fr auto;
      align-items: end;
    }
    .cta__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
